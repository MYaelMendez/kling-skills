{
  "name": "klingai-video",
  "version": "1.0.0",
  "description": "Official Kling AI Skill — text-to-video, image-to-video, Omni, and multi-shot generation",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "bin": {
    "kling-video": "./scripts/kling_video.mjs"
  },
  "scripts": {
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "format": "prettier --write \"**/*.{mjs,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{mjs,js,json,md}\"",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "build": "node scripts/gen_docs.mjs"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.mjs",
      "**/tests/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MYaelMendez/kling-skills.git"
  },
  "homepage": "https://myaelmendez.github.io/kling-skills/"
}
